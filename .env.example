# Copy to .env and add your Groq API key.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Equal influence during reciprocal rank fusion; keyword weight = 1 - semantic.
SEMANTIC_WEIGHT=0.5
RRF_K=60
CANDIDATE_K=100

# Cross-encoder scores are raw logits, not probabilities. Leave blank unless tuned.
RERANK_THRESHOLD=
# Optional legacy GraphRAG fallback, also reranked.
USE_GRAPH_RAG=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
